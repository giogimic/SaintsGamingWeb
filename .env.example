# ============================================================
#  Saints Gaming — Environment Configuration Template
#  Copy this file to .env and fill in your values,
#  OR run ./setup.sh which will create it automatically.
# ============================================================

# Public URL of your site (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Required for NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST="true"

# Database: "sqlite" or "mysql"
DB_PROVIDER="sqlite"

# SQLite example:
DATABASE_URL="file:./prisma/db/dev.db"
# MySQL/MariaDB example:
# DATABASE_URL="mysql://user:password@host:3306/saints_gaming"

# Discord OAuth (optional — leave blank to disable)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Your Discord server invite link (optional)
NEXT_PUBLIC_DISCORD_INVITE=""

# Discord bot bridge (POST /api/discord/events)
# Prefer DISCORD_BOT_SECRET; falls back to SAINTS_INTERNAL_SECRET
# DISCORD_BOT_SECRET=""
# SAINTS_INTERNAL_SECRET=""
# Map Discord role IDs → site permissionLevel (JSON object)
# Example: {"1234567890":200,"0987654321":400}
# DISCORD_ROLE_MAP=""

# FiveM server bridge (POST /api/fivem/events + /api/fivem/characters)
# Prefer FIVEM_API_KEY; falls back to SAINTS_INTERNAL_SECRET then AUTH_SECRET
# FIVEM_API_KEY=""
# Raw registered realtime envelopes: POST /api/internal/events (Bearer SAINTS_INTERNAL_SECRET)

# Forum / news text enhance (Grammar Check + Polish in markdown editor)
# Cloud provider (admin Forum Settings → Gemini)
# GEMINI_API_KEY=""
# Local provider uses Ollama on the server (install: https://ollama.com)
# Configure URL/model in Admin → Forum Settings (defaults http://127.0.0.1:11434)

# ─── Uploads (optional S3/CDN) ───────────────────────────────────
# Default: local disk at public/uploads (or UPLOAD_DIR)
# MAX_UPLOAD_SIZE=5242880
# UPLOAD_DIR="public/uploads"
# When ALL of bucket + credentials + CDN_BASE_URL are set, upload.ts writes to S3
# and returns absolute CDN URLs. Compatible with MinIO/R2 via S3_ENDPOINT.
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""              # e.g. https://xxxx.r2.cloudflarestorage.com or http://minio:9000
# S3_FORCE_PATH_STYLE="false" # true for MinIO
# CDN_BASE_URL="https://cdn.example.com"  # no trailing slash; also used for next/image remotePatterns
# NEXT_PUBLIC_CDN_BASE_URL=""             # optional client-visible alias of CDN_BASE_URL

# ─── Go MMO (lobby / Studio realtime — destination backend) ──
# Offered during ./scripts/setup.sh (recommended YES).
# When set, lobby + Studio live sockets connect here instead of same-origin
# Next/TS. Studio map save/load still uses Next `/api/maps` (Prisma).
# Next also POSTs /api/internal/sync-map to Go after map save (server-side).
# Leave blank / skip setup option to keep TypeScript server.ts sockets.
# NEXT_PUBLIC_GO_MMO_URL="http://127.0.0.1:3001"
# Docker Next → host Go: GO_MMO_INTERNAL_URL="http://host.docker.internal:3001"
# Force TS GameEngine even when Go URL set: ENABLE_TS_GAME_ENGINE=1
# Standalone: ./go-mmo/scripts/setup-go-mmo.sh --full
# Subdomain on existing Caddy: ./scripts/dev-proxy.sh add go.example.com 3001
