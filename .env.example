# ============================================================
#  Saints Gaming — Environment Configuration Template
#  Copy this file to .env and fill in your values,
#  OR run ./setup.sh which will create it automatically.
# ============================================================

# Public URL of your site (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Required for NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST="true"

# Database: "sqlite" or "mysql"
DB_PROVIDER="sqlite"

# SQLite example:
DATABASE_URL="file:./prisma/db/dev.db"
# MySQL/MariaDB example:
# DATABASE_URL="mysql://user:password@host:3306/saints_gaming"

# Discord OAuth (optional — leave blank to disable)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Your Discord server invite link (optional)
NEXT_PUBLIC_DISCORD_INVITE=""

# Discord bot bridge (POST /api/discord/events)
# Prefer DISCORD_BOT_SECRET; falls back to SAINTS_INTERNAL_SECRET
# DISCORD_BOT_SECRET=""
# SAINTS_INTERNAL_SECRET=""
# Map Discord role IDs → site permissionLevel (JSON object)
# Example: {"1234567890":200,"0987654321":400}
# DISCORD_ROLE_MAP=""

# FiveM server bridge (POST /api/fivem/events + /api/fivem/characters)
# Prefer FIVEM_API_KEY; falls back to SAINTS_INTERNAL_SECRET then AUTH_SECRET
# FIVEM_API_KEY=""
# Raw registered realtime envelopes: POST /api/internal/events (Bearer SAINTS_INTERNAL_SECRET)

# ─── MMO Scaling (Milestone 4) ───────────────────────────────────
# Area-of-interest zone size in tiles (default 16). Movement broadcasts
# only reach the 3×3 neighborhood of zones around an entity.
# MMO_AOI_ZONE_SIZE=16
# Set to 0 to force JSON movement deltas instead of compact binary.
# MMO_BINARY_MOVEMENT=1
# Optional Redis for multi-instance Socket.io fan-out (PM2 cluster / multi-host)
# REDIS_URL="redis://localhost:6379"
# Or:
# REDIS_HOST="localhost"
# REDIS_PORT="6379"
# REDIS_PASSWORD=""
