/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — only ignore real .env files, never the example template
.env
.env.local
.env.*.local

# vercel
.vercel

# temporary build logs
*-output.txt
run-build.bat

# typescript
*.tsbuildinfo
next-env.d.ts

