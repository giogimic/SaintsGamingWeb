/mysql_data/
/data/
/uploads/
/public/uploads/
/docker_build.log
docker-compose.yml


# AI / Local Work
/ai/
/articles/
# Runtime + agent logs — local only (write-ups live under .docs/logs/)
/logs/
/go-mmo/logs/
# Internal knowledge base (bibles, CONTINUE, system docs) — use .docs/
/info/
# Private developer & agent docs
/.agents/
/.tools/
/.docs/
/patch/
/the-game/
/scratch/
/tools/

