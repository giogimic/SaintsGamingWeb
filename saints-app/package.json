{
  "name": "saints-gaming",
  "version": "2.1.733",
  "private": true,
  "description": "Saints Gaming - Time To Play",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win zip && node scripts/copy-dist-exe.cjs"
  },
  "build": {
    "appId": "com.saintsgaming.app",
    "productName": "Saints Gaming",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*"
    ],
    "win": {
      "target": "zip"
    }
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  }
}
