{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saints World Studio",
  "version": "2.1.703",
  "identifier": "com.saintsgaming.worldstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Saints Gaming World Studio",
        "width": 1920,
        "height": 1080,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://localhost:* https://* ws://* wss://* 'unsafe-inline' 'unsafe-eval' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["saints-studio"]
      }
    },
    "updater": {
      "endpoints": [
        "https://saintsgaming.com/api/studio/update/windows-x86_64/latest.json"
      ]
    }
  }
}
